      <div class="modal-body">
        <form id="create-project-form">
          <div class="form-group">
            <label>Project Title</label>
            <input type="text" name="title" class="form-control" placeholder="e.g. Why Creator AI Pipelines Win" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Channel</label>
              <input type="text" name="channel" class="form-control" value="Main YouTube" required />
            </div>
            <div class="form-group">
              <label>Format</label>
              <select name="format" class="form-control">
                <option>YouTube video</option>
                <option>Short-form video</option>
                <option>Newsletter</option>
                <option>X / LinkedIn thread</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>Topic / Target Question</label>
            <input type="text" name="topic" class="form-control" placeholder="What core problem does this solve?" required />
          </div>
          <div class="form-group">
            <label>Angle / Perspective (Optional)</label>
            <textarea name="angle" class="form-control" placeholder="The honest, unique takeaway you want to deliver..."></textarea>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 16px;">
            <button type="button" class="btn-secondary" id="cancel-create-project">Cancel</button>
            <button type="submit" class="btn-primary">Create Project</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Add Task Modal -->
  <div id="task-modal-backdrop" class="modal-backdrop">
    <div class="modal-window" style="max-width: 500px;">
      <div class="modal-header">
        <h3 style="font-family: var(--font-heading); font-weight: 700;">Add Daily Task</h3>
        <button class="close-btn" id="close-task-modal">&times;</button>
      </div>
      <div class="modal-body">
        <form id="create-task-form">
          <div class="form-group">
            <label>Scheduled Time</label>
            <input type="text" name="time" class="form-control" placeholder="14:00" required />
          </div>
          <div class="form-group">
            <label>Task Title</label>
            <input type="text" name="title" class="form-control" placeholder="Script Review" required />
          </div>
          <div class="form-group">
            <label>Project / Detail</label>
            <input type="text" name="detail" class="form-control" placeholder="The Anatomy of Focus" />
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 16px;">
            <button type="button" class="btn-secondary" id="cancel-task-btn">Cancel</button>
            <button type="submit" class="btn-primary">Add Task</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Project Pack Viewer / Editor Modal -->
  <div id="pack-modal-backdrop" class="modal-backdrop">
    <div class="modal-window" style="max-width: 900px;">
      <div class="modal-header">
        <h3 id="pack-modal-title" style="font-family: var(--font-heading); font-weight: 700;">Project Production Pack</h3>
        <button class="close-btn" id="close-pack-modal">&times;</button>
      </div>
      <div class="modal-body" style="display: grid; grid-template-columns: 220px 1fr; gap: 20px; padding: 0; min-height: 450px;">
        <div style="background: var(--bg-surface); border-right: 1px solid var(--border-color); padding: 16px;" id="pack-file-list">
          <p style="font-size: 0.8rem; font-weight: 700; color: var(--text-dim); text-transform: uppercase; margin-bottom: 10px;">Files</p>
        </div>
        <div style="padding: 20px; display: flex; flex-direction: column; gap: 12px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <strong id="current-pack-file-name" style="font-family: var(--font-mono); color: var(--accent-light);">Select a file</strong>
            <button class="btn-primary" id="save-pack-file-btn" style="font-size: 0.8rem; padding: 6px 14px;">Save Changes</button>
          </div>
          <textarea id="pack-file-editor" class="form-control" style="flex: 1; font-family: var(--font-mono); font-size: 0.88rem; min-height: 340px; resize: none;"></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- Markdown Viewer Modal -->
  <div id="markdown-modal-backdrop" class="modal-backdrop">
    <div class="modal-window">
      <div class="modal-header">
        <h3 id="markdown-modal-title" style="font-family: var(--font-heading); font-weight: 700;">Research Note</h3>
        <button class="close-btn" id="close-markdown-modal">&times;</button>
      </div>
      <div class="modal-body">
        <pre id="markdown-modal-content" style="font-family: var(--font-mono); white-space: pre-wrap; font-size: 0.9rem; background: var(--bg-input); padding: 16px; border-radius: var(--radius-md); border: 1px solid var(--border-color);"></pre>
      </div>
    </div>
  </div>

  <!-- Custom Confirmation Modal -->
  <div id="confirm-modal-backdrop" class="modal-backdrop">
    <div class="modal-window" style="max-width: 440px;">
      <div class="modal-header">
        <h3 id="confirm-modal-title" style="font-family: var(--font-heading); font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 10px;">
          <i class="ph-bold ph-warning-circle" style="color: #ef4444;"></i> Delete Confirmation
        </h3>
        <button class="close-btn" id="close-confirm-modal">&times;</button>
      </div>
      <div class="modal-body" style="padding: 20px 24px;">
        <p id="confirm-modal-message" style="font-size: 0.95rem; color: var(--text-main); line-height: 1.5; margin-bottom: 24px;">Are you sure you want to delete this item?</p>
        <div style="display: flex; justify-content: flex-end; gap: 12px;">
          <button type="button" class="btn-secondary" id="confirm-modal-cancel">Cancel</button>
          <button type="button" class="btn-danger" id="confirm-modal-action">Delete</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import '../scripts/dashboard.ts';
  </script>
</BaseLayout>

